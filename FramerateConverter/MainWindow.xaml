<ui:FluentWindow x:Class="NewFPSConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="NewFPS Converter" 
        MinWidth="1180" MinHeight="780" Width="1180" Height="780"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Icon="Images/app.ico"
        Closing="MainWindow_OnClosing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom modern TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="NewFPS Converter" Icon="Images/app.ico">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="{Binding VersionInfo}" FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="20,10,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.5*" />
                <ColumnDefinition Width="2.5*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Files, Progress and Console -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- File Selection Cards -->
                    <RowDefinition Height="Auto" /> <!-- Progress Bar Card -->
                    <RowDefinition Height="*" />    <!-- Console Card -->
                </Grid.RowDefinitions>

                <!-- File Selection Panel -->
                <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Files &amp; Paths" FontSize="16" FontWeight="SemiBold" Foreground="#107C41" Margin="0,0,0,10"/>
                        
                        <!-- Batch Mode Toggle -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Batch Mode" VerticalAlignment="Center" Width="60" FontWeight="Medium" />
                             <ui:ToggleSwitch Grid.Column="1" 
                                              x:Name="ToggleSwitchBatchMode"
                                             Checked="ToggleSwitchBatchMode_Toggled"
                                             Unchecked="ToggleSwitchBatchMode_Toggled"
                                             Margin="5,0" />
                        </Grid>

                        <!-- Source File (Single Mode) -->
                        <Grid Margin="0,0,0,10" x:Name="GridSingleSource">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Source" VerticalAlignment="Center" Width="60" FontWeight="Medium" />
                            <ui:TextBox Grid.Column="1" x:Name="TextBoxSourceFilename" 
                                        PlaceholderText="Drag &amp; drop video here or browse..." 
                                        Text="{Binding SourceFilename, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                        IsReadOnly="False"
                                        AllowDrop="True"
                                        PreviewDragEnter="TextBox_PreviewDragEnter"
                                        PreviewDragOver="TextBox_PreviewDragEnter"
                                        PreviewDrop="TextBox_PreviewDropSourceFilename"
                                        Margin="5,0" />
                            <ui:Button Grid.Column="2" x:Name="ButtonBrowseSource" 
                                       Icon="{ui:SymbolIcon FolderOpen24}" 
                                       Appearance="Secondary"
                                       Click="ButtonBrowseSource_Click" />
                        </Grid>

                        <!-- Source Directory (Batch Mode) -->
                        <Grid Margin="0,0,0,10" x:Name="GridBatchSource" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Directory" VerticalAlignment="Center" Width="60" FontWeight="Medium" />
                            <ui:TextBox Grid.Column="1" x:Name="TextBoxSourceDirectory" 
                                        PlaceholderText="Select folder with videos..." 
                                        IsReadOnly="True"
                                        Margin="5,0" />
                            <ui:Button Grid.Column="2" x:Name="ButtonBrowseSourceDir" 
                                       Icon="{ui:SymbolIcon Folder24}" 
                                       Appearance="Secondary"
                                       Click="ButtonBrowseSourceDir_Click" />
                        </Grid>

                        <!-- Detected Files List (Batch Mode) -->
                        <Grid Margin="0,0,0,10" x:Name="GridFilesList" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="120" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Detected Files" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                            <ListBox Grid.Row="1" x:Name="ListBoxDetectedFiles" 
                                     Background="#1D1D1D" Foreground="#FFFFFF"
                                     BorderThickness="1" BorderBrush="#333333"
                                     FontSize="11" />
                        </Grid>

                        <!-- Target File (Single Mode) -->
                        <Grid x:Name="GridSingleTarget">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Target" VerticalAlignment="Center" Width="60" FontWeight="Medium" />
                            <ui:TextBox Grid.Column="1" x:Name="TextBoxTargetFilename" 
                                        PlaceholderText="Specify output video path..." 
                                        Text="{Binding TargetFilename, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsReadOnly="False"
                                        AllowDrop="True"
                                        PreviewDragEnter="TextBox_PreviewDragEnter"
                                        PreviewDragOver="TextBox_PreviewDragEnter"
                                        PreviewDrop="TextBox_PreviewDropTargetFilename"
                                        Margin="5,0" />
                            <ui:Button Grid.Column="2" x:Name="ButtonBrowseTarget" 
                                       Icon="{ui:SymbolIcon Save24}" 
                                       Appearance="Secondary"
                                       Click="ButtonBrowseTarget_Click" />
                        </Grid>

                        <!-- Target Directory (Batch Mode) -->
                        <Grid x:Name="GridBatchTarget" Visibility="Collapsed" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Output Dir" VerticalAlignment="Center" Width="60" FontWeight="Medium" />
                            <ui:TextBox Grid.Column="1" x:Name="TextBoxTargetDirectory" 
                                        PlaceholderText="Output folder for converted videos..." 
                                        IsReadOnly="True"
                                        Margin="5,0" />
                             <ui:Button Grid.Column="2" x:Name="ButtonBrowseTargetDir" 
                                        Icon="{ui:SymbolIcon FolderOpen24}" 
                                        Appearance="Secondary"
                                        Click="ButtonBrowseTargetDir_Click" />
                        </Grid>

                        <Grid x:Name="GridBatchFormat" Visibility="Collapsed" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Format" VerticalAlignment="Center" Width="60" FontWeight="Medium" />
                            <ComboBox Grid.Column="1" x:Name="ComboBoxBatchOutputFormat" Margin="5,0" SelectedValuePath="Tag" SelectedValue=".mp4">
                                <ComboBoxItem Tag=".mp4">MP4 Video</ComboBoxItem>
                                <ComboBoxItem Tag=".mkv">Matroska Video</ComboBoxItem>
                                <ComboBoxItem Tag=".avi">AVI Video</ComboBoxItem>
                                <ComboBoxItem Tag=".mov">MOV Video</ComboBoxItem>
                                <ComboBoxItem Tag=".webm">WebM Video</ComboBoxItem>
                                <ComboBoxItem Tag=".ivf">IVF Video</ComboBoxItem>
                                <ComboBoxItem Tag=".h264">Raw H.264</ComboBoxItem>
                                <ComboBoxItem Tag=".mpkg">Media Package</ComboBoxItem>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Conversion Progress & Info -->
                <ui:Card Grid.Row="1" Margin="0,0,0,12" Padding="15" Background="#1D1A1A1A">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Conversion Status" FontSize="14" FontWeight="SemiBold" Foreground="#ECE299"/>
                            <TextBlock Text="{Binding OriginalFrameRateText}" FontSize="12" Foreground="#888888" Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- Big glowing percentage -->
                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                   Text="{Binding ElementName=ProgressBarConversion, Path=Value, StringFormat={}{0:F1}%}" 
                                   FontSize="24" FontWeight="Bold" Foreground="#107C41" VerticalAlignment="Center" HorizontalAlignment="Right" />

                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" 
                                     x:Name="ProgressBarConversion" 
                                     Height="8" Margin="0,12,0,0" 
                                     Minimum="0" Maximum="100" Value="0" />
                    </Grid>
                </ui:Card>

                <!-- Live Log Console -->
                <ui:CardExpander Grid.Row="2" Padding="0" Header="Live Output Logs" IsExpanded="False" 
                                  Icon="{ui:SymbolIcon Code24}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid Background="#0F0F0F" MinHeight="180" Height="300">
                        <ListBox x:Name="ListBoxReport" BorderThickness="0" Background="Transparent" Foreground="#00FF66" 
                                 FontFamily="Consolas, Courier New" FontSize="11" Margin="10" Padding="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="2,1" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </ui:CardExpander>
            </Grid>

            <!-- RIGHT COLUMN: Options and Settings -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />     <!-- Option Panel Card -->
                    <RowDefinition Height="Auto" /> <!-- Action Button Card -->
                </Grid.RowDefinitions>

                <!-- Settings Panel Card -->
                <ui:Card Grid.Row="0" Margin="0,0,0,12" Padding="15" VerticalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="Configuration" FontSize="16" FontWeight="SemiBold" Foreground="#107C41" Margin="0,0,0,12"/>

                            <!-- Video Frame Rate Control -->
                            <StackPanel Margin="0,0,0,15">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Target Framerate (FPS)" FontWeight="Medium" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TargetFrameRate, StringFormat={}{0:F0} FPS}" 
                                               Foreground="#107C41" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="ComboBoxFrameRate" Width="180" VerticalAlignment="Center"
                                              SelectedValue="{Binding TargetFrameRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Tag">
                                        <ComboBoxItem Tag="25">25 FPS</ComboBoxItem>
                                        <ComboBoxItem Tag="30">30 FPS</ComboBoxItem>
                                        <ComboBoxItem Tag="60">60 FPS</ComboBoxItem>
                                    </ComboBox>
                                    <TextBlock Grid.Column="1" Text="Standardwerte" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#888888" />
                                </Grid>
                            </StackPanel>

                            <!-- Forced Size Configuration -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Forced Size Override" FontWeight="Medium" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:NumberBox Grid.Column="0" x:Name="TextBoxForcedWidth" PlaceholderText="Width" ClearButtonEnabled="False"
                                                  Minimum="0" Maximum="8192" Value="{Binding ForcedWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                                    <ui:NumberBox Grid.Column="2" x:Name="TextBoxForcedHeight" PlaceholderText="Height" ClearButtonEnabled="False"
                                                  Minimum="0" Maximum="8192" Value="{Binding ForcedHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBlock Text="Set to 0 to keep the original resolution." FontSize="11" Foreground="#888888" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Forced Bitrate -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Forced Bitrate override" FontWeight="Medium" Margin="0,0,0,6" />
                                <ComboBox x:Name="ComboBoxBitratePreset" Margin="0,0,0,6" SelectedValuePath="Tag" SelectedValue="0"
                                          SelectionChanged="ComboBoxBitratePreset_SelectionChanged">
                                    <ComboBoxItem Tag="0">Auto bitrate</ComboBoxItem>
                                    <ComboBoxItem Tag="8000">8,000 kbit/s</ComboBoxItem>
                                    <ComboBoxItem Tag="12000">12,000 kbit/s</ComboBoxItem>
                                    <ComboBoxItem Tag="19000">19,000 kbit/s</ComboBoxItem>
                                    <ComboBoxItem Tag="25000">25,000 kbit/s</ComboBoxItem>
                                </ComboBox>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:NumberBox Grid.Column="0" x:Name="SpinnerBitRate" 
                                                  Minimum="0" Maximum="100000"
                                                  Value="{Binding BitRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="1" Text="kbit/s" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="Medium"/>
                                </Grid>
                                <TextBlock Text="Set to 0 for auto Kush Gauge calculation." FontSize="11" Foreground="#888888" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Separator Margin="0,5,0,15" />

                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Batch Encoding" FontWeight="Medium" Margin="0,0,0,6" />
                                <ComboBox x:Name="ComboBoxGpuType" SelectedValuePath="Tag" SelectedValue="auto"
                                          SelectionChanged="ComboBoxGpuType_SelectionChanged">
                                    <ComboBoxItem Tag="auto">Auto detect</ComboBoxItem>
                                    <ComboBoxItem Tag="none">CPU only</ComboBoxItem>
                                    <ComboBoxItem Tag="nvidia">NVIDIA NVENC</ComboBoxItem>
                                    <ComboBoxItem Tag="amd">AMD AMF</ComboBoxItem>
                                    <ComboBoxItem Tag="intel">Intel Quick Sync</ComboBoxItem>
                                </ComboBox>
                                <ui:NumberBox x:Name="NumberBoxParallelJobs" Margin="0,6,0,0"
                                              Minimum="0" Maximum="16" Value="0" ClearButtonEnabled="False" />
                                <TextBlock Text="{Binding HardwareStatusText}" FontSize="11" Foreground="#888888" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Toggles and Switches -->
                            <TextBlock Text="Advanced Options" FontSize="13" FontWeight="SemiBold" Foreground="#107C41" Margin="0,0,0,10"/>
                            
                            <ui:ToggleSwitch x:Name="CheckBoxKeyFrames" Content="Key Frames Only" 
                                             IsChecked="{Binding KeyFramesOnly, Mode=TwoWay}" Margin="0,4"/>
                            
                            <ui:ToggleSwitch x:Name="CheckBoxNoFLicker" Content="Reduce Flicker (Adjust Frame Rate)" 
                                             IsChecked="{Binding NoFlickerMode, Mode=TwoWay}" Margin="0,4"/>
                            
                            <ui:ToggleSwitch x:Name="CheckBoxMinimum" Content="Do Not Reduce Frame Rate" 
                                             IsChecked="{Binding NoFpsReduce, Mode=TwoWay}" Margin="0,4"/>
                            
                            <ui:ToggleSwitch x:Name="CheckKeepAudio" Content="Keep Audio Track(s)" 
                                             IsChecked="{Binding KeepAudio, Mode=TwoWay}" Margin="0,4"/>

                            <ui:ToggleSwitch x:Name="CheckSlCompatibility" Content="Sympholight Compatibility" 
                                             IsChecked="{Binding SlCompatibility, Mode=TwoWay}" Margin="0,4"/>

                            <ui:ToggleSwitch Content="GPU MediaPackage Encoding" 
                                             IsChecked="{Binding GpuMediaPackage, Mode=TwoWay}" Margin="0,4"/>

                            <ui:ToggleSwitch x:Name="CheckOpenOutputDirectoryWhenDone" Content="Open Output Folder" 
                                             IsChecked="{Binding OpenOutputDirectoryWhenDone, Mode=TwoWay}" Margin="0,4"/>

                            <ui:ToggleSwitch x:Name="CheckBoxDebug" Content="Debug Engine Output" 
                                             IsChecked="{Binding DebugMode, Mode=TwoWay}" Margin="0,4"/>
                        </StackPanel>
                </ui:Card>

                <!-- Action Button Card -->
                <ui:Card Grid.Row="1" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Convert Button -->
                        <ui:Button Grid.Row="0" Grid.Column="0" x:Name="ButtonConvert" 
                                   Appearance="Primary" 
                                   Content="Convert" 
                                   Icon="{ui:SymbolIcon Play24}"
                                   FontWeight="SemiBold"
                                   Height="38" Margin="0,0,6,0"
                                   HorizontalAlignment="Stretch"
                                   Click="ButtonConvert_Click" />

                        <!-- Cancel Button -->
                        <ui:Button Grid.Row="0" Grid.Column="1" x:Name="ButtonCancel" 
                                   Appearance="Secondary" 
                                   Content="Cancel" 
                                   Icon="{ui:SymbolIcon Stop24}"
                                   Height="38" Margin="6,0,0,0"
                                   HorizontalAlignment="Stretch"
                                   Click="ButtonCancel_Click" />

                        <!-- Auxiliary Panel (About, Usage) -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" x:Name="ButtonAbout" 
                                       Appearance="Secondary" 
                                       Content="About Converter" 
                                       Icon="{ui:SymbolIcon Info24}"
                                       HorizontalAlignment="Center"
                                       Click="ButtonAbout_Click" />
                            <ui:Button Grid.Column="1" x:Name="ButtonUsage" 
                                       Appearance="Secondary" 
                                       Content="Command Line" 
                                       Icon="{ui:SymbolIcon Code24}"
                                       HorizontalAlignment="Center"
                                       Click="ButtonUsage_OnClick" />
                        </Grid>
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
