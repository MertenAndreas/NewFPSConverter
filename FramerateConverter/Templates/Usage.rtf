\viewkind4\uc1\pard\qc\b\fs32 NEWFPS CONVERTER\b0\fs20\par
\fs22 Video Framerate Converter & Batch Processor\par
Created by Thomas Sebastian\par
Derived from Free Video FPS Converter (GPL v2)\par\par
\pard\ql\b\fs24 Command Line Parameters:\b0\fs20\par\par
\b -b, --batch\b0\tab\tab Batch mode: run once, then terminate automatically.\par
\b -s, --source <file>\b0\tab Input video file path.\par
\b -d, --source-dir <dir>\b0\tab Source directory for batch processing multiple videos.\par
\b -t, --target <file>\b0\tab Output video or container file (.mpkg, .mp4, .h264, etc.).\par
\b -O, --target-dir <dir>\b0\tab Target directory for batch output files.\par
\b -f, --frames-per-second <fps>\b0\tab Target framerate (allowed: 10 - 200 FPS).\par
\b -k, --key-frames-only\b0\tab Output video will consist only of key frames (I-frames).\par
\b -n, --no-flicker\b0\tab Reduce flicker by adjusting framerate.\par
\b -m, --min-frame-rate\b0\tab Treat target FPS as minimum (do not reduce FPS).\par
\b -o, --overwrite\b0\tab Overwrite existing target file(s) without prompting.\par
\b -a, --audio\b0\tab\tab Keep original audio stream(s) if present.\par
\b -l, --sl-compatibility\b0\tab Enable Sympholight compatible H.264 output settings.\par
\b -p, --gpu-mediapackage\b0\tab Allow GPU hardware encoding for MediaPackage/H.264.\par
\b -W, --force-width <px>\b0\tab Enforce target video width in pixels.\par
\b -H, --force-height <px>\b0\tab Enforce target video height in pixels.\par
\b -r, --bitrate <kbits>\b0\tab Target bitrate in kbit/s (0 = automatic calculation).\par
\b -g, --gpu <device>\b0\tab GPU device or type: auto, none, vendor (nvidia/intel/amd), index (0, 1), or name.\par
\b --list-gpus\b0\tab\tab List all detected hardware graphics cards (GPUs) and exit.\par
\b -j, --parallel-jobs <n>\b0\tab Number of parallel encoding processes (0 = auto).\par
\b --no-gui\b0\tab\tab Run task completely in background without GUI window.\par
\b --help\b0\tab\tab Display command line help screen.\par
\b --version\b0\tab\tab Display version information.\par\par
\b\fs24 Return Codes:\b0\fs20\par\par
\b 0\b0\tab OK (Conversion successful)\par
\b 1\b0\tab Target file already exists and cannot be overwritten\par
\b 2\b0\tab Process was cancelled\par
\b 3\b0\tab Target framerate does not differ enough from source\par
\b 4\b0\tab Target framerate is illegal (allowed: 10 - 200 FPS)\par
\b 5\b0\tab Command line parameter error / invalid arguments\par
\b 6\b0\tab Input file error (not a valid video file)\par
\b 7\b0\tab GPL v2 license was not accepted\par
\b 8\b0\tab Target file is corrupt\par
\b 100\b0\tab Generic / unknown error\par
}
