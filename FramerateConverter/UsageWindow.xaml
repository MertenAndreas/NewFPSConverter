<ui:FluentWindow x:Class="NewFPSConverter.UsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Usage and CLI Commands"
        Width="640" Height="480"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Icon="Images/about_32.png"
        Loaded="Window_Loaded"
        ShowInTaskbar="False"
        Topmost="True">
    
    <Grid Margin="15,5,15,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Command Line Usage" Icon="Images/about_32.png" />

        <ui:Card Grid.Row="1" Margin="0,10,0,10" Padding="1">
            <RichTextBox x:Name="RtbGpl"
                         BorderThickness="0"
                         Background="Transparent"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto">
                <RichTextBox.Resources>
                    <Style TargetType="Hyperlink">
                        <Setter Property="Cursor" Value="Hand" />
                        <EventSetter Event="MouseLeftButtonDown" Handler="HandleClickOnHyperlink" />
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>
        </ui:Card>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <ui:Button x:Name="ButtonOk"
                       Width="100"
                       Margin="5,0"
                       Appearance="Primary"
                       Content="OK"
                       Icon="{ui:SymbolIcon Checkmark24}"
                       Click="ButtonOk_Click"
                       IsDefault="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>